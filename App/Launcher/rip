#!/bin/bash
# This is Place for my own commands for The Reapper app
DIR="$(dirname "$(dirname "$(dirname "$(readlink -f "$0")")")")"
START="$DIR/App/Launcher/Start.py"
MANAGE="$DIR/App/Launcher/Manage.py"
LOG_FLAG="$DIR/User/.log_enabled"
LOG_FILE="$DIR/User/reapper.log"

update_all() {
  if [ "$(id -u)" -eq 0 ]; then
    if [ -n "$SUDO_USER" ] && [ "$SUDO_USER" != "root" ]; then
      sudo -u "$SUDO_USER" env REAPPER_CHAIN=1 python3 "$MANAGE" self-update "$@" || return $?
    else
      REAPPER_CHAIN=1 python3 "$MANAGE" self-update "$@" || return $?
    fi
    python3 "$START" update "$@"
  else
    REAPPER_CHAIN=1 python3 "$MANAGE" self-update "$@" || return $?
    sudo python3 "$START" update "$@"
  fi
}

show_help() {
  local B="" C="" D="" R=""
  if [ -t 1 ]; then
    B=$'\033[1m'; C=$'\033[36m'; D=$'\033[2m'; R=$'\033[0m'
  fi
  echo
  echo "${B}The Reapper${R} ${D}- Apple Music downloader web UI${R}"
  echo
  echo "${B}Usage:${R} rip ${C}<command>${R} [options]"
  echo
  echo "${B}Run${R}"
  printf "  ${C}%-22s${R} %s\n" "rip -up" "start the web UI"
  printf "  ${C}%-22s${R} %s\n" "rip -check" "report missing or outdated components"
  echo
  echo "${B}Update${R}"
  printf "  ${C}%-22s${R} %s\n" "sudo rip -update" "update the project code, then the components"
  printf "  ${C}%-22s${R} %s\n" "sudo rip -update -y" "same, without questions"
  printf "  ${C}%-22s${R} %s\n" "sudo rip -update -b" "switch to the Beta branch, then update"
  printf "  ${C}%-22s${R} %s\n" "rip upgrade" "update only the project code (add --force to discard local changes)"
  echo
  echo "${B}Logging${R}"
  printf "  ${C}%-22s${R} %s\n" "rip -log" "start writing User/reapper.log"
  printf "  ${C}%-22s${R} %s\n" "rip -log -stop" "stop writing the log file"
  echo
  echo "${B}Remove${R}"
  printf "  ${C}%-22s${R} %s\n" "sudo rip -rm" "remove the program, keep User/ settings and music (backup)"
  printf "  ${C}%-22s${R} %s\n" "sudo rip -rm -f" "remove everything including User/ settings, music stays in a backup"
  echo
  echo "${D}Aliases: run = -up, update/install = -update, check = -check, uninstall = -rm, log = -log${R}"
  echo
}

cmd_log() {
  case "$1" in
    "")
      mkdir -p "$DIR/User" && touch "$LOG_FLAG" || { echo "rip: cannot create $LOG_FLAG" >&2; return 1; }
      echo "Logging is ON. Everything the web UI prints goes to:"
      echo "  $LOG_FILE"
      echo "It works in the running UI too (if you started it before updating Main.py, restart it once)."
      echo "Stop with: rip -log -stop"
      ;;
    -stop|stop)
      if [ -e "$LOG_FLAG" ]; then
        rm -f "$LOG_FLAG"
        [ -f "$LOG_FILE" ] && echo "$(date '+%Y-%m-%d %H:%M:%S') --- logging stopped (rip -log -stop) ---" >> "$LOG_FILE"
        echo "Logging is OFF."
      else
        echo "Logging was not running."
      fi
      [ -f "$LOG_FILE" ] && echo "Log file: $LOG_FILE"
      ;;
    *)
      echo "Usage: rip -log [-stop]" >&2
      return 2
      ;;
  esac
}

main() {
  case "$1" in
    -up|run)
      cd "$DIR" && exec python3 Main.py
      ;;
    ""|-h|--help|help)
      show_help
      exit 0
      ;;
    -update|update|install)
      shift
      update_all "$@"
      ;;
    -rm|uninstall)
      shift
      exec python3 "$MANAGE" uninstall "$@"
      ;;
    purge)
      shift
      exec python3 "$MANAGE" purge "$@"
      ;;
    self-update|upgrade)
      shift
      exec python3 "$MANAGE" self-update "$@"
      ;;
    -log|log)
      shift
      cmd_log "$@"
      exit $?
      ;;
    check|-check)
      exec python3 "$START" check
      ;;
    *)
      echo "rip: unknown command '$1'" >&2
      show_help >&2
      exit 1
      ;;
  esac
}

main "$@"
exit $?
